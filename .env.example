# Node 24 or newer. No credentials are needed for the demo.
HOST=127.0.0.1
PORT=3000
# Optional absolute path; defaults to ./data/rally.sqlite
# DB_PATH=/app/data/rally.sqlite
# Optional live conversation. Use an instance role or your normal AWS profile.
AWS_REGION=us-west-1
# BEDROCK_MODEL_ID=<approved Converse-compatible model or inference-profile ID>
# Never copy the Backend .env into this project or container.

# Twilio: account Auth Token is also needed to verify incoming webhooks.
SMS_MODE=preview
PUBLIC_BASE_URL=https://rall-e.ai
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional API key credentials for sending (otherwise use Account SID/Auth Token).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# A2P sender pool. Prefer this over From for US outbound.
TWILIO_MESSAGING_SERVICE_SID=
# Comma-separated consenting tester numbers, in +15551234567 format.
SMS_ALLOWED_RECIPIENTS=
# Private presenter password, at least 24 characters. Never put this in VITE_*.
SMS_OPERATOR_KEY=
SMS_DAILY_LIMIT=20
# Conversational texting (replies + group updates): total per day and per recipient per day.
SMS_CONVERSATION_DAILY_LIMIT=150
SMS_PER_RECIPIENT_DAILY_LIMIT=40
# Gap between outbound sends (Sole Proprietor A2P allows about 1 message/second).
SMS_SEND_SPACING_MS=1100

# Texting agent (Claude). Create a key at https://platform.claude.com/settings/keys and paste it here.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Vault: 32-byte base64 key (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Back it up.
VAULT_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# iMessage via Sendblue (sendblue.com). Set MESSAGING_PROVIDER=sendblue once the keys and number are in.
MESSAGING_PROVIDER=twilio
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
# Discovery
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
# Live music (JamBase Data API, https://data.jambase.com)
JAMBASE_KEY=
# Farmers markets / agritourism (USDA Local Food Portal, free key: usdalocalfoodportal.com/fe/fregisterpublicapi/)
USDA_LOCALFOOD_KEY=

# Restaurant phone calls through Vapi. Use an imported carrier number; free Vapi numbers are documented as inbound only. See docs/VAPI.md.
# The calling tool stays hidden until VAPI_CALLS_ENABLED=live and SMS_MODE=live.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_CALLS_ENABLED=off
VAPI_DAILY_LIMIT=10
